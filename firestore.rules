rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'dzakyinne@gmail.com' ||
        request.auth.token.email == 'innedzaky@gmail.com' ||
        request.auth.token.email == 'rioirsyad72@gmail.com'
      );
    }

    // ====================================================
    // ARTICLES COLLECTION
    // Public read-only ONLY for published articles.
    // Public write is strictly forbidden (0 celah write publik).
    // Admin write is restricted to authenticated superadmins.
    // ====================================================
    match /articles/{articleId} {
      allow read: if (resource != null && resource.data.status == 'published') || isSuperAdminEmail();
      allow write: if isSuperAdminEmail();
    }

    // ====================================================
    // USERS COLLECTION
    // Closed to public; only authenticated user themselves or superadmin.
    // ====================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdminEmail());
      allow write: if isSuperAdminEmail();
    }

    // ====================================================
    // TAXONOMIES (CATEGORIES & TAGS)
    // Public read allowed, write strictly superadmin.
    // ====================================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdminEmail();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isSuperAdminEmail();
    }

    // ====================================================
    // DEFAULT CATCH-ALL
    // Strict default deny for any other collections.
    // ====================================================
    match /{document=**} {
      allow read, write: if isSuperAdminEmail();
    }
  }
}
